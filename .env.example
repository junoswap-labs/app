# Junoswap Marketplace — environment variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริง (.env.local ถูก gitignore ไว้)
# NEXT_PUBLIC_* จะถูก inline เข้า client bundle — ห้ามใส่ความลับใน prefix นี้

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side เท่านั้น (Route Handler / sync poller) ห้ามหลุดไป client

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=              # ใช้สร้าง deep-link https://t.me/<username>?start=<code>
TELEGRAM_BANNER_FILE_ID=           # cache file_id หลังอัปโหลด banner ครั้งแรก กันอัปโหลดซ้ำ

# --- Contract addresses (Bitkub Chain) ---
NEXT_PUBLIC_NFT_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_RWA_ESCROW_ADDRESS=
NEXT_PUBLIC_PERMISSION_REGISTRY_ADDRESS=      # Admin/Partner/Authorize roles — see contracts/src/PermissionRegistry.sol
NEXT_PUBLIC_JUNO_PTS_ADDRESS=                 # KAP-22 loyalty points — see contracts/src/JunoPts.sol
NEXT_PUBLIC_REDEEM_NFT_SETTLEMENT_ADDRESS=    # Redeem NFT-leg settlement — see contracts/src/RedeemNftSettlement.sol

# --- Chain / sync ---
KUB_RPC_URL=https://rpc.bitkubchain.io   # ใช้โดย sync poller (viem public client); ไม่ใช่ archive node
NEXT_PUBLIC_CHAIN_ID=96                   # 96 = mainnet, 25925 = testnet
NFT_MARKETPLACE_DEPLOY_BLOCK=0            # poller's first block to scan if sync_state has no row yet
RWA_ESCROW_DEPLOY_BLOCK=0                 # same, for RwaEscrow

# --- Cron protection ---
CRON_SECRET=                        # กัน /api/cron/* ถูกเรียกจากนอก

# --- Session auth (SIWE) ---
SESSION_SECRET=                     # random 32+ byte secret, HMAC-signs the session/nonce cookies — server-side only

# --- Image upload (Redeem items / RWA listings) ---
PINATA_JWT=                         # server-side only — Pinata JWT for pinFileToIPFS, see app/api/upload/image
