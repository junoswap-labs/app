# Junoswap Marketplace — environment variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริง (.env.local ถูก gitignore ไว้)
# NEXT_PUBLIC_* จะถูก inline เข้า client bundle — ห้ามใส่ความลับใน prefix นี้

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side เท่านั้น (Route Handler / sync poller) ห้ามหลุดไป client

# --- Contract addresses (Bitkub Chain) ---
NEXT_PUBLIC_NFT_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_RWA_ESCROW_ADDRESS=
NEXT_PUBLIC_PERMISSION_REGISTRY_ADDRESS=      # Admin/Partner/Authorize roles — see contracts/src/PermissionRegistry.sol
NEXT_PUBLIC_DEV_ADMIN_BYPASS=false            # LOCAL DEV ONLY — set true to treat every connected wallet as holding every role (skips PermissionRegistry entirely). Only takes effect when NODE_ENV=development (i.e. `bun run dev`); ignored by `next build`/`next start`. See lib/onchain/dev-bypass.ts. NEVER set true anywhere but your own local .env.local.
NEXT_PUBLIC_JUNO_PTS_ADDRESS=                 # KAP-22 loyalty points — see contracts/src/JunoPts.sol
NEXT_PUBLIC_REDEEM_NFT_SETTLEMENT_ADDRESS=    # Redeem NFT-leg settlement — see contracts/src/RedeemNftSettlement.sol
# A SECOND, independent deployment of contracts/src/RwaEscrow.sol (same contract, different
# constructor args — FEE_BPS=1000 for the 10% Registered-tier platform fee) dedicated to Redeem
# merch orders. Never point this at the same address as NEXT_PUBLIC_RWA_ESCROW_ADDRESS — the two
# have unrelated feeBps/feeCollector and the sync poller routes their identically-named events to
# different tables (see lib/onchain/sync-contracts.ts).
NEXT_PUBLIC_REDEEM_RWA_ESCROW_ADDRESS=
NEXT_PUBLIC_AIRDROP_ESCROW_ADDRESS=           # shareable-link token giveaways — see contracts/src/AirdropEscrow.sol

# --- Redeem: Official-tier merch payout fallback ---
# Official merch items have no per-listing payout_wallet (they're the platform's own inventory) —
# this is the `seller` passed to the Redeem RwaEscrow's fund() for those orders. Paired with that
# deployment's feeCollector, both portions of the payment end up platform-controlled either way.
NEXT_PUBLIC_REDEEM_OFFICIAL_TREASURY_ADDRESS=

# --- Redeem NFT-leg offer signing ---
# The wallet that signs RedeemOffer structs server-side when a buyer redeems an NFT-kind item (the
# "operator" in contracts/src/RedeemNftSettlement.sol — must hold Admin or PARTNER_REDEEM_ROLE on
# PermissionRegistry). A dedicated hot wallet, NOT a multisig — it only ever signs, never sends txs.
REDEEM_OPERATOR_PRIVATE_KEY=
NEXT_PUBLIC_REDEEM_OPERATOR_ADDRESS=          # the address REDEEM_OPERATOR_PRIVATE_KEY corresponds to

# --- Airdrop: relayer service (./server) ---
# ./server is a standalone process (NOT part of this Next.js app) holding the hot wallet that
# submits claimFor() on behalf of claimants in "creator pays gas" campaigns — see ./server/.env.example
# for its own AIRDROP_RELAYER_PRIVATE_KEY. This app only needs to know how to reach it.
AIRDROP_RELAYER_SERVICE_URL=                  # e.g. https://airdrop-relayer.up.railway.app
AIRDROP_RELAYER_SERVICE_SECRET=               # shared secret, sent as a header — must match ./server's SHARED_SECRET
NEXT_PUBLIC_AIRDROP_RELAYER_ADDRESS=          # the address ./server's AIRDROP_RELAYER_PRIVATE_KEY corresponds to — shown to creators so they know where to send gas KUB for "I pay gas" campaigns

# --- Airdrop: self-pay claim authorization signing ---
# The wallet app/api/airdrop/claim/route.ts signs ClaimAuthorization structs with, after its own
# GPS/IP/dedupe checks pass — closes the "call claim() directly on-chain" bypass for self-pay
# campaigns (see contracts/src/AirdropEscrow.sol's BACKEND_SIGNER_ROLE/claimAuthorizationDigest).
# A dedicated hot wallet, NOT a multisig — it only ever signs, never sends txs.
AIRDROP_SIGNER_PRIVATE_KEY=
NEXT_PUBLIC_AIRDROP_SIGNER_ADDRESS=           # the address AIRDROP_SIGNER_PRIVATE_KEY corresponds to — granted BACKEND_SIGNER_ROLE at deploy

# --- Chain / sync ---
KUB_RPC_URL=https://rpc.bitkubchain.io   # ใช้โดย sync poller (viem public client); ไม่ใช่ archive node
NEXT_PUBLIC_CHAIN_ID=96                   # 96 = mainnet, 25925 = testnet
NFT_MARKETPLACE_DEPLOY_BLOCK=0            # poller's first block to scan if sync_state has no row yet
RWA_ESCROW_DEPLOY_BLOCK=0                 # same, for RwaEscrow
REDEEM_NFT_SETTLEMENT_DEPLOY_BLOCK=0      # same, for RedeemNftSettlement
REDEEM_RWA_ESCROW_DEPLOY_BLOCK=0          # same, for the Redeem-dedicated RwaEscrow deployment
AIRDROP_ESCROW_DEPLOY_BLOCK=0             # same, for AirdropEscrow

# --- Cron protection ---
CRON_SECRET=                        # กัน /api/cron/* ถูกเรียกจากนอก

# --- Session auth (SIWE) ---
SESSION_SECRET=                     # random 32+ byte secret, HMAC-signs the session/nonce/telegram-link cookies — server-side only

# --- Image upload (Redeem items / RWA listings) ---
PINATA_JWT=                         # server-side only — Pinata JWT for pinFileToIPFS, see app/api/upload/image


# --- Connect: Telegram bot (deep-link pairing, see app/api/telegram) ---
# The bot token lives in the telegram-bot-app service, not here — this app never calls Telegram's
# API, it only builds the deep link and answers the bot's pairing calls.
TELEGRAM_BOT_USERNAME=              # ใช้สร้าง deep-link https://t.me/<username>?start=<code>
TELEGRAM_BOT_SERVICE_SECRET=        # shared with the telegram-bot-app service — sent as x-bot-secret on every call to /api/telegram/link
