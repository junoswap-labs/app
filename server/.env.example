# Airdrop relayer service — a standalone process, NOT part of the main Next.js app (see
# CLAUDE.md / the repo root README for why: the main app's one existing hot wallet key only ever
# signs, never sends transactions — this key actively submits claimFor() txs, which needs
# sequential nonce management that doesn't fit a serverless deploy).

# The wallet that submits claimFor() on behalf of claimants in "creator pays gas" campaigns. Must
# hold RELAYER_ROLE on the deployed AirdropEscrow (granted via RELAYER_ADDRESS at deploy time, see
# contracts/script/DeployAirdropEscrow.s.sol) — a dedicated hot wallet, funded with enough native
# KUB to cover gas for every relayed claim.
AIRDROP_RELAYER_PRIVATE_KEY=

AIRDROP_ESCROW_ADDRESS=               # must match the main app's NEXT_PUBLIC_AIRDROP_ESCROW_ADDRESS
KUB_RPC_URL=https://rpc.bitkubchain.io
CHAIN_ID=96                           # 96 = mainnet, 25925 = testnet

# Must match the main app's AIRDROP_RELAYER_SERVICE_SECRET — sent as the x-relayer-secret header
# on every request; this endpoint trusts its caller entirely (see routes/relay-claim.ts), the main
# app is expected to have already done SIWE/GPS/IP checks before calling here. The process refuses
# to boot without it, so an unset value fails the Railway healthcheck instead of serving wide open.
# Use a long random value (`openssl rand -hex 32`) — the repo is public, this header is the only
# thing standing between the internet and the relayer's hot wallet.
SHARED_SECRET=

PORT=8787
