# Airdrop relayer service — a standalone process, NOT part of the main Next.js app (see
# CLAUDE.md / the repo root README for why: the main app's one existing hot wallet key only ever
# signs, never sends transactions — this key actively submits claimFor() txs, which needs
# sequential nonce management that doesn't fit a serverless deploy).

# The wallet that submits claimFor() on behalf of claimants in "creator pays gas" campaigns. Must
# hold RELAYER_ROLE on EVERY deployed AirdropEscrow it serves (granted via RELAYER_ADDRESS at
# deploy time, see contracts/script/DeployAirdropEscrow.s.sol) — a dedicated hot wallet, funded on
# each chain with enough native KUB to cover gas for every relayed claim. Same EOA on all chains.
AIRDROP_RELAYER_PRIVATE_KEY=

# Multi-chain: one relayer serves every chain it has an escrow address for. The main app sends the
# target chainId in each /relay-claim request and the relayer picks the matching set below.
# Set at least one; the mainnet pair is the common case.
AIRDROP_ESCROW_ADDRESS_96=            # must match the main app's config/contract-addresses.ts ADDRESSES_BY_CHAIN[96].airdropEscrow
KUB_RPC_URL_96=https://rpc.bitkubchain.io
AIRDROP_ESCROW_ADDRESS_25925=         # must match ADDRESSES_BY_CHAIN[25925].airdropEscrow
KUB_RPC_URL_25925=https://rpc-testnet.bitkubchain.io

# Legacy single-chain vars — still honoured for backward compatibility. If AIRDROP_ESCROW_ADDRESS_<id>
# is unset for the chain CHAIN_ID names, these seed it. New deploys should use the per-chain vars above.
# AIRDROP_ESCROW_ADDRESS=
# KUB_RPC_URL=
# CHAIN_ID=96

# Must match the main app's AIRDROP_RELAYER_SERVICE_SECRET — sent as the x-relayer-secret header
# on every request; this endpoint trusts its caller entirely (see routes/relay-claim.ts), the main
# app is expected to have already done SIWE/GPS/IP checks before calling here. The process refuses
# to boot without it, so an unset value fails the Railway healthcheck instead of serving wide open.
# Use a long random value (`openssl rand -hex 32`) — the repo is public, this header is the only
# thing standing between the internet and the relayer's hot wallet.
SHARED_SECRET=

PORT=8787
